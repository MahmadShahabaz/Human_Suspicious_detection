# Optional Telegram alert integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN_SECONDARY=
TELEGRAM_CHAT_ID_SECONDARY=
SHAS_SECRET_KEY=
SHAS_ENV=development

# Optional local overrides. Render sets these paths to its persistent disk.
SHAS_DATA_DIR=
SHAS_MODEL_DIR=
SHAS_UPLOAD_DIR=
SHAS_DATABASE_PATH=
SHAS_MAX_UPLOAD_BYTES=536870912

# Optional URL to a private .tar.gz archive containing the original model files.
# Keep any URL signature/token private in the hosting provider's environment settings.
SHAS_MODEL_ARCHIVE_URL=
SHAS_MODEL_ARCHIVE_TOKEN=
